 int bch2_dev_remove_stripes(struct bch_fs *, unsigned, unsigned, struct printbuf *);
+int bch2_dev_free_orphan_stripe_buckets(struct btree_trans *, struct bch_dev *);
 
 void bch2_ec_stop_dev(struct bch_fs *, struct bch_dev *);
 void bch2_fs_ec_stop(struct bch_fs *);
--- a/fs/data/migrate.c
+++ b/fs/data/migrate.c
@@ -302,6 +302,15 @@
 			bch2_trans_unlock(trans);
 			bch2_reconcile_wakeup(c);
 			msleep(100 << min(nr_stalled, 4u));
+
+			/*
+			 * Orphaned stripe buckets - whose stripe key was torn down
+			 * without dropping their bucket refs - have no backpointer
+			 * and can never be reached by this scan; once repair has had
+			 * a chance, sweep them directly.
+			 */
+			if (nr_stalled == 3)
+				try(bch2_dev_free_orphan_stripe_buckets(trans, ca));
 		}
 
