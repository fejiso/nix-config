+/*
+ * Reserve-watermark allocations (copygc, btree/reclaim) should drain onto
+ * non-pressured devices first instead of consuming writepoint or partial
+ * buckets on devices in c->copygc.wants_space while non-pressured candidate
+ * devices still have room to satisfy the remaining replicas:
+ */
+static bool dev_alloc_avoid_leaves_room(struct bch_fs *c,
+					struct alloc_request *req,
+					unsigned dev)
+{
+	if (req->ec || req->watermark <= BCH_WATERMARK_normal ||
+	    !test_bit(dev, c->copygc.wants_space.d))
+		return true;
+
+	struct bch_devs_mask non_avoid;
+	bitmap_andnot(non_avoid.d, req->devs_may_alloc.d,
+		      c->copygc.wants_space.d, BCH_SB_MEMBERS_MAX);
+
+	return req->nr_replicas - req->nr_effective >
+		bitmap_weight(non_avoid.d, BCH_SB_MEMBERS_MAX);
+}
