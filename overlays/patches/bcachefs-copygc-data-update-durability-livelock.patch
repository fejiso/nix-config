+/*
+ * Online durability of @k remaining after dropping @ptrs_kill and stripping
+ * EC stripe associations in @ptrs_kill_ec.
+ *
+ * Must use the same whole-key deduplicated online durability check as
+ * bch2_bkey_drop_extra_durability() and bch2_bkey_drop_extra_ec_durability():
+ * summing per-pointer bch2_extent_ptr_durability() ignores device sharing
+ * across stripes/replicas and offline stripe blocks, causing data updates to
+ * pick nr_replicas == 0 while bch2_extent_drop_ptrs() refuses to drop the
+ * pointer.
+ */
+int bch2_bkey_durability_keeping(struct btree_trans *trans, struct bkey_s_c k,
+				 unsigned ptrs_kill, unsigned ptrs_kill_ec,
+				 struct bch_devs_list *devs_have,
+				 unsigned *keeping)
+{
+	struct bch_fs *c = trans->c;
+	struct bkey_ptrs_c ptrs = bch2_bkey_ptrs_c(k);
+	const union bch_extent_entry *entry;
+	struct extent_ptr_decoded p;
+	struct durability_dedup seen = {};
+	struct bkey_durability d = { .min_durability = U8_MAX };
+	unsigned ptr_bit = 1;
+
+	if (devs_have)
+		devs_have->nr = 0;
+
+	bkey_for_each_ptr_decode(k.k, ptrs, p, entry) {
+		if (!p.ptr.cached && !(ptr_bit & ptrs_kill)) {
+			if (devs_have && p.ptr.dev != BCH_SB_MEMBER_INVALID &&
+			    devs_have->nr < ARRAY_SIZE(devs_have->data))
+				bch2_dev_list_add_dev(devs_have, p.ptr.dev);
+
+			if (p.has_ec && !(ptr_bit & ptrs_kill_ec)) {
+				int ret = bch2_stripe_durability(trans, p, &d, &seen, NULL);
+				if (ret < 0)
+					return ret;
+			} else if (p.ptr.dev != BCH_SB_MEMBER_INVALID) {
+				guard(rcu)();
+				unsigned cur = bch2_dev_durability(c, p.ptr.dev);
+
+				if (!__test_and_set_bit(p.ptr.dev, seen.total.d))
+					d.total += cur;
+				if (bch2_dev_idx_is_online(c, p.ptr.dev) &&
+				    !__test_and_set_bit(p.ptr.dev, seen.online.d))
