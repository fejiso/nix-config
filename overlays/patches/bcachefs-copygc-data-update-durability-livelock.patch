+static unsigned copygc_btree_nonpressured_durability(struct bch_fs *c)
+{
+	unsigned durability = 0;
+
+	guard(rcu)();
+	struct bch_devs_mask devs = target_rw_devs(c, BCH_DATA_btree, c->opts.metadata_target);
+	if (bitmap_empty(devs.d, BCH_SB_MEMBERS_MAX))
+		devs = target_rw_devs(c, BCH_DATA_btree, 0);
+
+	unsigned i;
+	for_each_set_bit(i, devs.d, BCH_SB_MEMBERS_MAX) {
+		if (test_bit(i, c->copygc.wants_space.d))
+			continue;
+
+		struct bch_dev *ca = bch2_dev_rcu_noerror(c, i);
+		if (ca && dev_buckets_free(ca, BCH_WATERMARK_normal))
+			durability += ca->mi.durability;
+	}
+
+	return durability;
+}
