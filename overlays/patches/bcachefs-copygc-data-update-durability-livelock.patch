+static bool stripe_has_copygc_dev(const struct bch_stripe *s,
+				  const struct bch_devs_mask *devs_mask)
+{
+	for (unsigned i = 0; i < s->nr_blocks; i++) {
+		unsigned dev = s->ptrs[i].dev;
+		if (dev < BCH_SB_MEMBERS_MAX && test_bit(dev, devs_mask->d))
+			return true;
+	}
+	return false;
+}
+
+static inline struct bpos ec_copygc_lru_start(void)
+{
+	return lru_pos(BCH_LRU_STRIPE_FRAGMENTATION, 0, STRIPE_LRU_POS_EMPTY + 1);
+}
+
+static inline struct bpos ec_copygc_lru_resume(struct bch_fs *c)
+{
+	struct bpos start = ec_copygc_lru_start();
+	struct bpos end = lru_end(BCH_LRU_STRIPE_FRAGMENTATION);
+
+	return bkey_lt(c->copygc.ec_lru_pos, start) ||
+	       bkey_gt(c->copygc.ec_lru_pos, end)
+		? start
+		: c->copygc.ec_lru_pos;
+}
+
+static bool stripe_is_ec_copygc_candidate(struct bch_fs *c,
+					  const struct bch_stripe *s,
+					  const struct bch_devs_mask *devs_mask,
+					  u64 bucket_frag_ratio)
+{
+	unsigned nr_data = s->nr_blocks - s->nr_redundant, blocks_nonempty = 0;
+
+	if (!nr_data || !stripe_has_copygc_dev(s, devs_mask))
+		return false;
+
+	for (unsigned i = 0; i < nr_data; i++) {
+		if (!stripe_blockcount_get(s, i))
+			continue;
+		if (s->ptrs[i].dev == BCH_SB_MEMBER_INVALID ||
+		    !bch2_dev_idx_is_online(c, s->ptrs[i].dev))
+			return false;
+		blocks_nonempty++;
+	}
+
+	if (!blocks_nonempty || blocks_nonempty == nr_data)
+		return false;
+
+	u64 stripe_frag_ratio = div_u64(blocks_nonempty * (1ULL << 31), nr_data);
+
+	return stripe_frag_ratio &&
+		(!bucket_frag_ratio || stripe_frag_ratio < bucket_frag_ratio);
+}
