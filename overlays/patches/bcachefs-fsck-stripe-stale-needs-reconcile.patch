diff --git a/fs/data/reconcile/check.c b/fs/data/reconcile/check.c
index 6d6fd83e0..7753d221f 100644
--- a/fs/data/reconcile/check.c
+++ b/fs/data/reconcile/check.c
@@ -454,6 +454,42 @@ fsck_err:
 	return ret;
 }
 
+/*
+ * needs_reconcile on a stripe means a block sits on a bad/evacuating device
+ * and the stripe needs repair. If no block does, the flag is stale - it was
+ * set during a transient device state, and since nothing at runtime clears
+ * it for a non-degraded stripe (stripe repair only rewrites degraded
+ * stripes), reconcile would reprocess the stripe on every pass forever
+ * without changing anything.
+ */
+static int check_stripe_stale_needs_reconcile(struct btree_trans *trans,
+					      struct btree_iter *iter,
+					      struct bkey_s_c k)
+{
+	struct bch_fs *c = trans->c;
+	int ret = 0;
+
+	if (k.k->type != KEY_TYPE_stripe)
+		return 0;
+
+	const struct bch_stripe *s = bkey_s_c_to_stripe(k).v;
+
+	if (!s->needs_reconcile || bch2_stripe_degraded(c, s))
+		return 0;
+
+	CLASS(printbuf, buf)();
+	prt_str(&buf, "stripe marked needs_reconcile, but is not degraded\n");
+	bch2_bkey_val_to_text(&buf, c, k);
+
+	if (fsck_err(trans, stripe_needs_reconcile_stale, "%s", buf.buf)) {
+		struct bkey_i_stripe *update =
+			errptr_try(bch2_bkey_make_mut_typed(trans, iter, &k, 0, stripe));
+		update->v.needs_reconcile = 0;
+	}
+fsck_err:
+	return ret;
+}
+
 noinline_for_stack
 static int check_stripe_can_widen(struct btree_trans *trans)
 {
@@ -473,7 +509,8 @@ static int check_stripe_can_widen(struct btree_trans *trans)
 			POS_MIN, BTREE_ITER_prefetch, k,
 			NULL, NULL, BCH_TRANS_COMMIT_no_enospc, ({
 		bch2_progress_update_iter(trans, &c->recovery.progress, &iter) ?:
-		check_stripe_can_widen_one(trans, &iter, k, &cache, scan_pending);
+		check_stripe_can_widen_one(trans, &iter, k, &cache, scan_pending) ?:
+		check_stripe_stale_needs_reconcile(trans, &iter, k);
 	}));
 }
 
